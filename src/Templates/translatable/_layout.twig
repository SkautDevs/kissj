<!DOCTYPE html>
<html lang="{{ locale|default('cs') }}">

<head>
    <meta charset="utf-8"/>
    <meta name="robots" content="noindex, nofollow">
    <meta http-equiv="Content-Security-Policy" content="
        default-src 'self';
        font-src 'self' https://cdn.skauting.cz/ https://fonts.gstatic.com/;
        img-src 'self' https://is.skaut.cz/;
        style-src-elem 'self' https://fonts.googleapis.com/;
        style-src-attr 'unsafe-inline';
    ">
    <meta name="theme-color" content="{{ event.eventType.getThemeColorLight }}" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="{{ event.eventType.getThemeColorDark }}" media="(prefers-color-scheme: dark)">
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{{ '_layout.title' | trans }} - {{ event.readableName }} - kissj</title>

    <link rel="icon" href="{{ base_path() }}/{{ event.eventType.getFaviconNameWithoutLeadingSlash }}" type="image/png">
    {% set appleTouchIcon = event.eventType.getAppleTouchIconNameWithoutLeadingSlash %}
    {% if appleTouchIcon is not null %}
        <link rel="apple-touch-icon" href="{{ base_path() }}/{{ appleTouchIcon }}">
    {% endif %}
    <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">
    <link rel="stylesheet" href="{{ base_path() }}/styles.css">
    {% if event.eventType.getStylesheetNameWithoutLeadingSlash is not null %}
        <link rel="stylesheet" href="{{ base_path() }}/{{ event.eventType.getStylesheetNameWithoutLeadingSlash }}">
    {% endif %}
</head>

<body class="wrapper">
<a href="#main-content" class="skip-link">{{ '_layout.skipToContent' | trans }}</a>
<header>
<h1 class="text-center">{{ '_layout.title' | trans }} <span class="event-name">{{ event.readableName }}</span></h1>
<div class="user text-right">
    <nav class="language-nav" aria-label="{{ '_layout.languageSelection' | trans }}">
        {% set currentLocale = locale|default('cs') %}
        {% for localeSlug, localeText in event.eventType.getLanguages() %}
            <a href="?locale={{ localeSlug }}" lang="{{ localeSlug }}"{% if localeSlug == currentLocale %} aria-current="true"{% endif %}>{{ localeText }}</a>{% if not loop.last %} | {% endif %}
        {% endfor %}
    </nav>
    {% if user is not null %}
        | {% if user.loginType.value == 'skautis' %}
            <img src="https://is.skaut.cz/Login/Favicons/favicon-16x16.png" alt="SkautIS">
            {% if not user.skautisHasMembership %}
                {{ '_layout.skautisAccountNotConnected' | trans }} <span aria-hidden="true">❌</span>
            {% endif %}
        {% else %}
            <span aria-hidden="true">📧</span>
        {% endif %}
        {{ user.email }}
        | <a href="{{ url_for('logout', {'eventSlug': event.slug}) }}">{{ '_layout.logOut' | trans }}</a>
        {% set userStatus = user.status.value %}
    {% else %}
        {% set userStatus = "unregistred" %}
    {% endif %}
</div>
<nav aria-label="{{ '_layout.registrationProgress' | trans }}">
    <ul class="steps">
        <li class="step is-active"{% if userStatus not in ['open', 'closed', 'approved', 'paid'] %} aria-current="step"{% endif %}>
            {{ '_layout.titleBar' | trans }}
        </li>
        <li class="step {% if userStatus == 'open' or userStatus == 'closed' or userStatus == 'approved' or userStatus == 'paid' %}is-active{% endif %}"{% if userStatus == 'open' %} aria-current="step"{% endif %}>{{ '_layout.editingBar' | trans }}</li>
        <li class="step {% if userStatus == 'closed' or userStatus == 'approved' or userStatus == 'paid' %}is-active{% endif %}"{% if userStatus == 'closed' %} aria-current="step"{% endif %}>{{ '_layout.lockedBar' | trans }}</li>
        <li class="step {% if userStatus == 'approved' or userStatus == 'paid' %}is-active{% endif %}"{% if userStatus == 'approved' %} aria-current="step"{% endif %}>{{ '_layout.approvedBar' | trans }}</li>
        <li class="step {% if userStatus == 'paid' %}is-active{% endif %}"{% if userStatus == 'paid' %} aria-current="step"{% endif %}>{{ '_layout.payedBar' | trans }}</li>
    </ul>
</nav>
</header>
<div class="flash-wrapper">
    {% for flashMessage in flashMessages.dumpMessagesIntoArray() %}
        <div class="alert alert-{{ flashMessage['type'] }}" role="{{ flashMessage['type'] in ['error', 'warning'] ? 'alert' : 'status' }}">
            {{ flashMessage['message'] }}
        </div>
    {% endfor %}
</div>
<main id="main-content" tabindex="-1" class="container">
    {% block content %}{% endblock %}
</main>
<footer>
    <span class="footer-item">
        <a href="{{ event.webUrl }}" target="_blank">{{ event.readableName }}</a>
        | <a href="https://devs.skauting.cz/" target="_blank">{{ '_layout.creator' | trans }}</a>
        {# the Ukraine link can be swapped for the formal "Junák – český skaut, z. s." footer when the time comes #}
        | <a href="https://www.stojimezaukrajinou.cz/" target="_blank"><span aria-hidden="true">🇺🇦</span> stojimezaukrajinou.cz</a>
    </span>
    <a href="{{ event.webUrl }}" class="footer-item" target="_blank">
        <img class="footer-logo" src="{{ event.logoUrl }}" alt="{{ '_layout.eventLogoAlt' | trans({'%eventName%': event.readableName}) }}">
    </a>
</footer>
{% if event.eventType.getScriptNameWithoutLeadingSlash is not null %}
    <script src="{{ base_path() }}/{{ event.eventType.getScriptNameWithoutLeadingSlash }}" defer></script>
{% endif %}
</body>
</html>
