{% extends "_layout.twig" %}

{% block content %}
    <div class="card">
        <a href="{{ url_for('admin-export-food', {'eventSlug': event.slug}) }}"
           target="_blank"
           class="btn">{{ 'foodStats-admin.exportFoodData' | trans }}</a>
        <br/>

        {% if event.allowTroops or event.allowPatrols%}
            <a href="{{ url_for('admin-export-patrols-food', {'eventSlug': event.slug}) }}"
               target="_blank"
               class="btn">{{ 'foodStats-admin.exportPatrolsFoodData' | trans }}</a>
            <br/>
        {% endif %}

        <a href="{{ url_for('admin-dashboard', {'eventSlug': event.slug}) }}"
           class="btn btn-small btn-grey">{{ 'foodStats-admin.back' | trans }}</a>

    </div>

    <div class="card">
        <h3>{{ 'foodStats-admin.presentHeader' | trans }}</h3>
        <table>
            <thead>
            <tr>
                <th></th>
                {% for food in presentFoodStatistic.foodTypes %}
                    <th style="text-align: left">{{ food|trans }}</th>
                {% endfor %}
                <th style="text-align: left">{{ 'foodStats-admin.total' | trans }}</th>
            </tr>
            </thead>
            <tbody>
            {% for role in presentFoodStatistic.roles %}
                <tr>
                    <th>{{ role|trans }}</th>
                    {% for food in presentFoodStatistic.foodTypes %}
                        <td>{{ presentFoodStatistic.matrix[role][food] }}</td>
                    {% endfor %}
                    <td>{{ presentFoodStatistic.rowTotals[role] }}</td>
                </tr>
            {% endfor %}
            <tr>
                <th>{{ 'foodStats-admin.total' | trans }}</th>
                {% for food in presentFoodStatistic.foodTypes %}
                    <td>{{ presentFoodStatistic.colTotals[food] }}</td>
                {% endfor %}
                <td>{{ presentFoodStatistic.grandTotal }}</td>
            </tr>
            </tbody>
        </table>

        <h3>{{ 'foodStats-admin.otherFoodHeader' | trans }}</h3>
        {% if presentFoodStatistic.otherFoodParticipants is empty %}
            <p>{{ 'foodStats-admin.otherFoodNone' | trans }}</p>
        {% else %}
            <table>
                <thead>
                <tr>
                    <th style="text-align: left">{{ 'foodStats-admin.name' | trans }}</th>
                    <th style="text-align: left">{{ 'stats-admin.role' | trans }}</th>
                    {% if presentFoodStatistic.showContingent %}
                        <th style="text-align: left">{{ 'detail.contingentTitle' | trans }}</th>
                    {% endif %}
                    <th style="text-align: left">{{ 'detail.foodHeader' | trans }}</th>
                    <th style="text-align: left">{{ 'detail.notice' | trans }}</th>
                    <th style="text-align: left">{{ 'detail.issues' | trans }}</th>
                </tr>
                </thead>
                <tbody>
                {% for participant in presentFoodStatistic.otherFoodParticipants %}
                    <tr>
                        <td>{{ participant.getFullName }}</td>
                        <td>{{ ('role.' ~ participant.role.value) | trans }}</td>
                        {% if presentFoodStatistic.showContingent %}
                            {# bare .contingent breaks via LeanMapper's __call whenever it's empty; getContingent
                               matches the getNotes-style idiom already used in changeRole.twig / detailsMinimal.twig.
                               "is empty" (not ?:) so a contingent/note/issue of exactly "0" still renders, matching
                               the PHP-side showContingent check, which uses !== '' rather than a falsy test. #}
                            <td>{{ participant.getContingent is empty ? '—' : participant.getContingent }}</td>
                        {% endif %}
                        <td>{{ participant.foodPreferences | trans }}</td>
                        <td>{{ participant.getNotes is empty ? '—' : participant.getNotes | nl2br }}</td>
                        <td>{{ participant.getHealthProblems is empty ? '—' : participant.getHealthProblems | nl2br }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>

    {% for aggregator, row in foodStatistic.rows %}
        <div class="card">
                <h3>{{aggregator|trans}}</h3>
                <table >
                    <thead>
                    <tr>
                        <th>x</th>
                        {% for diet in foodStatistic.diet_types %}
                            <th  style="text-align: left" > {{diet|trans}}</th>
                        {% endfor %}
                    </tr>
                    </thead>
                    <tbody>
                    {% for date in foodStatistic.dates %}
                        <tr>
                            <th>{{date}}</th>
                            {% for diet in foodStatistic.diet_types %}
                                <td>{{ row[date][diet]|trans }}</td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
        </div>
    {% endfor %}
{% endblock %}
