{% extends "_layout.twig" %}

{% block pageTitle %}{{ 'pageTitle.approve' | trans }}{% endblock %}

{% block content %}
    <script src="{{ base_path() }}/js/admin-ajax-submit.js" defer></script>
    <div class="card">
        <h2>{{ 'approve-admin.approving' | trans }} {{ event.readableName }}</h2>
        <a href="{{ url_for('admin-dashboard', {'eventSlug': event.slug} ) }}"
           class="btn btn-grey btn-small">{{ 'approve-admin.back' | trans }}</a>
    </div>
    {% for section in sections %}
        {% if section.participants is not empty %}
            <div class="card">
                <h2>{{ section.titleKey | trans }}</h2>
            </div>
            {% for person in section.participants %}
                <div class="card">
                    {% if section.childContentArbiter is not null %}
                        <h3>{{ person.getPatrolName }}</h3>
                        <br/>
                        <h4>{{ person.getFullName }}</h4>
                        {% include 'widgets/detailsForAdmin.twig' with {'person': person, 'ca': section.contentArbiter} %}
                        <br/>

                        {% if section.role.value == 'pl' %}
                            <h4>{{ 'role.pp' | trans }} {{ 'dashboard.details' | trans }}</h4>
                            {% for pp in person.patrolParticipants %}
                                {% include 'widgets/detailsForAdmin.twig' with {'person': pp, 'ca': section.childContentArbiter, 'useShortNaming': true} %}
                                <br/>
                            {% endfor %}
                        {% else %}
                            <h4>{{ 'role.tp' | trans }} {{ 'dashboard.details' | trans }}</h4>
                            {% for tp in person.troopParticipants %}
                                {% include 'widgets/detailsForAdmin.twig' with {'person': tp, 'ca': section.childContentArbiter, 'useShortNaming': true} %}
                                <br/>
                            {% endfor %}
                        {% endif %}
                    {% else %}
                        <h4>{{ person.getFullName }}</h4>
                        {% include 'widgets/detailsForAdmin.twig' with {'person': person, 'ca': section.contentArbiter} %}
                        <br/>
                    {% endif %}
                    <a href="{{ url_for('admin-deny-participant-show', {'participantId': person.getId, 'eventSlug': event.slug}) }}"
                       class="btn btn-grey btn-small">{{ 'approve-admin.deny' | trans }}</a>
                    <br/>
                    <br/>
                    <form method="post"
                          action="{{ url_for('admin-approve', {'participantId': person.getId, 'eventSlug': event.slug}) }}"
                          class="js-ajax-submit"
                          data-ajax-action="{{ url_for('admin-approve-json', {'participantId': person.getId, 'eventSlug': event.slug}) }}"
                          data-remove-target=".card"
                          data-error-fallback="{{ 'flash.error.actionFailed' | trans }}">
                        <input type="submit"
                               value="{{ 'approve-admin.approveAndSend' | trans }}"
                               class="btn btn-small">
                    </form>
                </div>
            {% endfor %}
        {% else %}
            <div class="card">
                <h2>{{ 'approve-admin.none' | trans }} {{ section.titleKey | trans }} {{ 'approve-admin.need' | trans }}</h2>
            </div>
        {% endif %}
    {% endfor %}
{% endblock %}
