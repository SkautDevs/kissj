{% extends "_layout.twig" %}

{% block content %}
    <script src="{{ base_path() }}/js/programme-image-resize.js" defer></script>
    <div class="card text-left">
        <h2>{{ programme ? programme.name : 'programme.admin.new'|trans }}</h2>

        {% if sections is empty %}
            <p>
                {{ 'programme.admin.formSectionNone'|trans }}
                <a href="{{ url_for('admin-programme-sections', {eventSlug: event.slug}) }}">
                    {{- 'programme.admin.sections.open'|trans -}}
                </a>
            </p>
            <div class="text-center">
                <a class="btn btn-small btn-grey" href="{{ url_for('admin-programmes', {eventSlug: event.slug}) }}">
                    {{- 'programme.admin.back'|trans -}}
                </a>
            </div>
        {% else %}
            <form method="post" enctype="multipart/form-data"
                  action="{{ programme
                      ? url_for('admin-programme-update', {eventSlug: event.slug, programmeId: programme.id})
                      : url_for('admin-programme-create', {eventSlug: event.slug}) }}">
                <div class="form-group">
                    <label for="name">{{ 'programme.admin.formName'|trans }}:</label>
                    <br/>
                    <input class="form-control form-wide" type="text" id="name" name="name" required
                           value="{{ programme ? programme.name : '' }}">
                </div>
                <div class="form-group">
                    <label for="description">{{ 'programme.admin.formDescription'|trans }}:</label>
                    <br/>
                    <textarea class="form-control form-wide" id="description"
                              name="description">{{ programme ? programme.description : '' }}</textarea>
                </div>
                <div class="form-group">
                    <label for="placeId">{{ 'programme.admin.formPlace'|trans }}:</label>
                    <br/>
                    <select class="form-control form-wide" id="placeId" name="placeId">
                        <option value="">{{ 'programme.admin.formPlaceNone'|trans }}</option>
                        {% for place in places %}
                            <option value="{{ place.id }}" {{ selectedPlaceId == place.id ? 'selected' : '' }}>
                                {{- place.name -}}
                            </option>
                        {% endfor %}
                    </select>
                    <br/>
                    <label for="newPlaceName">{{ 'programme.admin.formPlaceNew'|trans }}:</label>
                    <br/>
                    <input class="form-control form-wide" type="text" id="newPlaceName" name="newPlaceName" value="">
                </div>
                <div class="form-group">
                    <label for="start">{{ 'programme.admin.formStart'|trans }}:</label>
                    <br/>
                    <input class="form-control form-wide" type="datetime-local" id="start" name="start" required
                           value="{{ programme ? programme.start|date('Y-m-d\\TH:i') : '' }}">
                </div>
                <div class="form-group">
                    <label for="end">{{ 'programme.admin.formEnd'|trans }}:</label>
                    <br/>
                    <input class="form-control form-wide" type="datetime-local" id="end" name="end" required
                           value="{{ programme ? programme.end|date('Y-m-d\\TH:i') : '' }}">
                </div>
                <div class="form-group">
                    <label for="capacity">{{ 'programme.admin.formCapacity'|trans }}:</label>
                    <br/>
                    <input class="form-control form-wide" type="number" id="capacity" name="capacity" min="1" required
                           value="{{ programme ? programme.capacity : 10 }}">
                </div>
                <div class="form-group">
                    <label for="isPreregistered">{{ 'programme.admin.formPreregistered'|trans }}:</label>
                    <input id="isPreregistered" type="checkbox" name="isPreregistered" value="1"
                           {{ programme and programme.isPreregistered ? 'checked' : '' }}>
                </div>
                <div class="form-group">
                    <label for="sectionId">{{ 'programme.admin.formSection'|trans }}:</label>
                    <br/>
                    <select class="form-control form-wide" id="sectionId" name="sectionId" required>
                        <option value=""></option>
                        {% for section in sections %}
                            <option value="{{ section.id }}"
                                    {{ programme and programme.section.id == section.id ? 'selected' : '' }}>
                                {{- section.getLabel() -}}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="form-group">
                    <label>{{ 'programme.admin.formRoles'|trans }}:</label>
                    {% for role in allRoles %}
                        <label class="form-control">
                            <input type="checkbox" name="roles[]" value="{{ role.value }}"
                                   {{ programme and role in programme.getTargetRoles() ? 'checked' : '' }}>
                            {{ ('role.' ~ role.value)|trans }}
                        </label>
                    {% endfor %}
                </div>
                <div class="form-group">
                    <label for="images">{{ 'programme.admin.formImages'|trans }}:</label>
                    <br/>
                    <input class="form-control form-wide" type="file" id="images" name="images[]" multiple
                           accept="image/jpeg,image/png,image/gif"
                           data-resize-max-edge="1600" data-resize-quality="0.9">
                    <br/>
                    <small>{{ 'programme.admin.formImagesHint'|trans }}</small>
                </div>
                <div class="text-center">
                    <br/>
                    <input class="btn btn-small" type="submit" value="{{ 'programme.admin.formSave'|trans }}">
                    <br/>
                    <br/>
                    <a class="btn btn-small btn-grey"
                       href="{{ url_for('admin-programmes', {eventSlug: event.slug}) }}">
                        {{- 'programme.admin.back'|trans -}}
                    </a>
                </div>
            </form>
        {% endif %}
    </div>

    {% if programme %}
        <div class="card text-left">
            <h3>{{ 'programme.admin.images.title'|trans }}</h3>
            {% for image in images %}
                {% set imageParams = {eventSlug: event.slug, programmeId: programme.id, imageId: image.id} %}
                <div class="form-group">
                    <img class="programme-thumbnail" src="{{ url_for('admin-programme-image-thumb', imageParams) }}"
                         alt="{{ image.alt }}">
                    <form method="post" action="{{ url_for('admin-programme-image-update', imageParams) }}">
                        <label for="alt-{{ image.id }}">{{ 'programme.admin.images.alt'|trans }}:</label>
                        <br/>
                        <input class="form-control form-wide" type="text" id="alt-{{ image.id }}" name="alt"
                               value="{{ image.alt }}">
                        <input type="submit" class="btn btn-small" value="{{ 'programme.admin.images.save'|trans }}">
                    </form>
                    <form method="post" style="display: inline"
                          action="{{ url_for('admin-programme-image-move', imageParams|merge({direction: 'up'})) }}">
                        <input type="submit" class="btn btn-small btn-grey"
                               value="{{ 'programme.admin.images.moveUp'|trans }}">
                    </form>
                    <form method="post" style="display: inline"
                          action="{{ url_for('admin-programme-image-move', imageParams|merge({direction: 'down'})) }}">
                        <input type="submit" class="btn btn-small btn-grey"
                               value="{{ 'programme.admin.images.moveDown'|trans }}">
                    </form>
                    <form method="post" style="display: inline"
                          action="{{ url_for('admin-programme-image-delete', imageParams) }}">
                        <input type="submit" class="btn btn-small btn-grey"
                               value="{{ 'programme.admin.images.delete'|trans }}">
                    </form>
                </div>
            {% else %}
                <p>{{ 'programme.admin.images.none'|trans }}</p>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
