{% extends "_layout.twig" %}

{% block pageTitle %}{{ 'pageTitle.openParticipants' | trans }}{% endblock %}

{% block content %}
    <div class="card">
        <h2>{{ 'open-admin.open' | trans }} {{ event.readableName }}</h2>
        <a href="{{ url_for('admin-dashboard', {'eventSlug': event.slug} ) }}"
           class="btn btn-grey btn-small">{{ 'approve-admin.back' | trans }}</a>
    </div>
    {% for section in sections %}
        {% if section.participants is not empty %}
            <div class="card">
                <h2>{{ section.titleKey | trans }}</h2>
            </div>
            {% for person in section.participants %}
                <div class="card">
                    {% if section.role.value == 'pl' %}
                        <h3>{{ person.getPatrolName }}</h3>
                        {{ 'stats-admin.numberPatrolParticipants' | trans }}: <b>{{ person.getPatrolParticipantsCount + 1}}</b><br/>
                        <br/>
                        <h4>{{ person.getFullName }}</h4>
                        {% include 'widgets/detailsMinimal.twig' with {'person': person, 'ca': section.contentArbiter} %}
                        <br/>

                        <h4>{{ 'role.pp' | trans }} {{ 'dashboard.details' | trans }}</h4>
                        {% for pp in person.patrolParticipants %}
                            {% include 'widgets/detailsMinimal.twig' with {'person': pp, 'ca': section.childContentArbiter, 'useShortNaming': true} %}
                            <br/>
                        {% endfor %}
                    {% elseif section.role.value == 'tl' %}
                        <h3>{{ person.getPatrolName }}</h3>
                        {{ 'stats-admin.numberPatrolParticipants' | trans }}: <b>{{ person.getTroopParticipantsCount + 1}}</b><br/>
                        <br/>
                        <h4>{{ person.getFullName }}</h4>
                        {% include 'widgets/detailsMinimal.twig' with {'person': person, 'ca': section.contentArbiter} %}
                    {% elseif section.role.value == 'guest' or section.role.value == 'ot' %}
                        <h4>{{ person.getFullName }}</h4>
                        {% include 'widgets/detailsMinimal.twig' with {'person': person, 'ca': section.contentArbiter} %}
                        <br/>
                    {% else %}
                        {% include 'widgets/detailsMinimal.twig' with {'person': person, 'ca': section.contentArbiter} %}
                        <br/>
                    {% endif %}
                </div>
            {% endfor %}
        {% else %}
            <div class="card">
                <h2>{{ 'open-admin.none' | trans }} {{ section.titleKey | trans }} {{ 'open-admin.need' | trans }}</h2>
            </div>
        {% endif %}
    {% endfor %}
{% endblock %}
