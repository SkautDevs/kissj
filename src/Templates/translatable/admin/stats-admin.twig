{% extends "_layout.twig" %}

{% block pageTitle %}{{ 'pageTitle.stats' | trans }}{% endblock %}

{% block content %}
    <div class="card">
        <h2>{{ 'stats-admin.stats' | trans }} {{ event.readableName }}</h2>
        {% if event.eventType.isMultiplePaymentsAllowed %}
            <form method="POST" action="{{ url_for('admin-generate-more-payments', {'eventSlug': event.slug} ) }}">
                <input class="btn btn-small" type="submit" 
                       value="{{ 'stats-admin.generate-more-payments' | trans }}">
            </form>
        {% endif %}
        <a href="{{ url_for('admin-dashboard', {'eventSlug': event.slug} ) }}"
           class="btn btn-grey btn-small">{{ 'approve-admin.back' | trans }}</a>
    </div>

    <div class="card">
        <h2>{{ 'stats-admin.paid' | trans }} {{ event.readableName }}</h2>

        {% for section in sections %}
            <h4>{{ section.titleKey | trans }}</h4>
            {% for person in section.participants %}
                {% include 'widgets/participantRow.twig' with {'person': person, 'ca': section.contentArbiter} %}<br/>
            {% endfor %}
        {% endfor %}
    </div>
{% endblock %}
