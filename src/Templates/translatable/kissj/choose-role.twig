{% extends "_layout.twig" %}

{% block content %}
    <div class="two-cards">
        <div class="card">
            <h2>{{ 'chooseRole.chooseRole' | trans }}</h2>
            {% for role in roles %}
                <form method="POST" action="{{ url_for('setRole', {'eventSlug': event.slug}) }}">
                    <input type="hidden" name="role" value="{{ role.value }}">
                    <input type="submit" class="btn form-wide"
                           value="{{ ('chooseRole.registerAs' ~ role.value|capitalize)|trans }}">
                </form>
                <br/>
            {% endfor %}
        </div>

        <div class="card">
            <h2>{{ 'chooseRole.rolesAdvice' | trans }}</h2>
            {% for role in roles %}
                <p>
                    <b>{{ ('role.' ~ role.value)|trans }}</b>
                    {{ ('chooseRole.advice' ~ role.value|capitalize ~ 'Text')|trans }}
                </p>
            {% endfor %}
        </div>
    </div>
{% endblock %}
