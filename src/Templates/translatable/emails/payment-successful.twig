{% extends "emails/_mail-layout.twig" %}

{% block content %}
    <div class="text-center">
        <p>{{ (textPrefix ~ '.received') | trans }} {{ event.readableName }}{{ (textPrefix ~ '.thanks') | trans }}</p>

        {% if event.getEventType.showParticipantInfoInMail %}
            <p>{{ (textPrefix ~ '.qrInfo') | trans }}</p>
            <img src="cid:qr_info" alt="QR participant info"/>
        {% endif %}

        <p>{{ (textPrefix ~ '.enjoy') | transGendered(genderSuffix) | raw }}</p>
    </div>
{% endblock %}
