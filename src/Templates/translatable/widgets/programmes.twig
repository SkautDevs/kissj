{% set hasProgrammes = enrolledProgrammes is not empty or autoenrolledProgrammes is not empty %}
{% if userStatus == 'paid' and (hasProgrammes or event.isProgrammeEnrolmentOpen) %}
    <div class="card">
        <h2>{{ 'programme.widget.title'|trans }}</h2>

        <ul>
            {% for programme in autoenrolledProgrammes %}
                <li>{{ programme.name }}, {{ programme.start|date('j. n. Y H:i') }}, {{ programme.getPlaceName() }}</li>
            {% endfor %}
            {% for enrolment in enrolledProgrammes %}
                <li>
                    {{ enrolment.programme.name }},
                    {{ enrolment.programme.start|date('j. n. Y H:i') }},
                    {{ enrolment.programme.getPlaceName() }}
                </li>
            {% endfor %}
        </ul>

        {% if event.isProgrammeEnrolmentOpen %}
            <p class="programme-eventapp-hint">{{ 'programme.widget.eventAppHint'|trans }}</p>
        {% endif %}

        {% if eventAppUrl %}
            <a class="btn" href="{{ eventAppUrl }}" target="_blank" rel="noopener">
                {{- 'programme.widget.all'|trans -}}
            </a>
        {% endif %}
    </div>
{% endif %}
