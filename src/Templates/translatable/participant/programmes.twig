{% extends "_layout.twig" %}

{% block content %}
    <div class="card">
        <h1>{{ 'programme.list.title'|trans }}</h1>

        <ul>
            {% for programme in programmes %}
                <li>
                    <a href="{{ url_for('programme-detail', {eventSlug: event.slug, programmeId: programme.id}) }}">{{ programme.name }}</a>
                    {{ programme.start|date('j. n. Y H:i') }} - {{ programme.end|date('H:i') }},
                    {{ programme.place }}

                    {% if programme.isPreregistered %}
                        <span>{{ 'programme.list.preregistered'|trans }}</span>
                    {% elseif programme.id in ownProgrammeIds %}
                        <span class="programme-registered">{{ 'programme.list.registered'|trans }}</span>
                    {% endif %}
                </li>
            {% else %}
                <li>{{ 'programme.list.empty'|trans }}</li>
            {% endfor %}
        </ul>
    </div>
{% endblock %}
