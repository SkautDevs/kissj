{% extends "_layout.twig" %}

{% block content %}
    <div class="card">
        <h2>{{ 'ticketTransfer.title' | trans }}</h2>
        <p>{{ 'ticketTransfer.description' | trans }}</p>

        <form method="GET" action="{{ url_for('showTransferTicket', {'eventSlug': event.slug}) }}">
            <label for="tieCode">{{ 'ticketTransfer.recipientTieCode' | trans }}</label>
            <input id="tieCode" name="tieCode" type="text" value="{{ tieCode }}"
                   pattern="[a-zA-Z]{6}" title="{{ 'dashboard.tieCodeFormat' | trans }}"
                   placeholder="ABCDEF" required><br/><br/>
            <input class="btn btn-small" type="submit" value="{{ 'ticketTransfer.preview' | trans }}">
        </form>
        <br/>

        {% if tieCode %}
            {% if to %}
                <h2>{{ 'ticketTransfer.recipient' | trans }}</h2>
                {{ 'ticketTransfer.recipientName' | trans }}: <b>{{ to.getFullName }}</b><br/>
                {{ 'payments-admin.status' | trans }}: <b>{{ ('dashboard.userStatus.' ~ to.user.status.value)|trans }}</b>
            {% else %}
                <h4>{{ 'ticketTransfer.recipientNotFound' | trans }} {{ tieCode }}</h4>
            {% endif %}

            {% if transferPossible %}
                <form method="POST" action="{{ url_for('transferTicket', {'eventSlug': event.slug}) }}">
                    <input name="tieCode" type="hidden" value="{{ tieCode }}" required>
                    <input class="btn btn-small" type="submit" value="{{ 'ticketTransfer.confirm' | trans }}">
                </form><br/>
            {% else %}
                <h2>{{ 'ticketTransfer.notPossible' | trans }}</h2>
            {% endif %}
        {% endif %}

        <a href="{{ url_for('dashboard', {'eventSlug': event.slug}) }}"
           class="btn btn-grey btn-small">{{ 'changeDetails.back' | trans }}</a>
    </div>
{% endblock %}
