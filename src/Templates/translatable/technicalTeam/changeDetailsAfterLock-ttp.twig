{% extends "_layout.twig" %}

{% block content %}
    <div class="card text-left">
        <h2>{{ 'changeDetails.editDetailsAfterLock' | trans }}</h2>
        <form method="POST" action="{{ url_for('ttp-changeDetailsAfterLock', {'participantId': pDetails.id, 'eventSlug': event.slug}) }}">
            {% include 'widgets/changeDetails.twig' with {'personDetails': pDetails, 'editableItems': ca.getEditableAfterLockItems()} %}
            <div class="text-center">
                <br/>
                <input class="btn btn-small" type="submit" value="{{ 'changeDetails.save' | trans }}">
                <br/>
                <br/>
                <a class="btn btn-small btn-grey"
                   href="{{ url_for('dashboard', {'eventSlug': event.slug}) }}">{{ 'changeDetails.back' | trans }}</a>
            </div>
        </form>
    </div>
{% endblock %}
